meta {
  name: Get Device Credentials
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/device/{{deviceId}}/credentials
  body: none
  auth: none
}

headers {
  X-Authorization: Bearer {{accessToken}}
  Accept: application/json
}

script:post-response {
  if (res.status === 200 && res.body) {
    bru.setEnvVar("deviceCredentialsId", res.body.id.id);
    bru.setEnvVar("deviceAccessToken", res.body.credentialsId);
  }
}
