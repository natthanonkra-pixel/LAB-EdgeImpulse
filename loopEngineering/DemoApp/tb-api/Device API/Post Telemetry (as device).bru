meta {
  name: Post Telemetry (as device)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/{{deviceAccessToken}}/telemetry
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "temperature": 25.5,
    "humidity": 60
  }
}
